senha = input("Digite sua senha: ")

def validar_senha(senha):
    erros = []  
    
    if len(senha) < 8 or len(senha) > 20:
        erros.append("A senha deve conter pelo menos 8 caracteres e no máximo 20.")
    
    if not any(char.isupper() for char in senha):
        erros.append("A senha deve conter pelo menos uma letra maiúscula.")
    
    if not any(char.isdigit() for char in senha):
        erros.append("A senha deve conter pelo menos um número.")
    
    if not any(char in "!@#$%^&*()-_=+[]{}|;:'\",.<>?/" for char in senha):
        erros.append("A senha deve conter pelo menos um caractere especial.")
    
    if " " in senha:
        erros.append("A senha não deve conter espaços em branco.")
    
    if senha.lower() in ["password", "12345678", "qwerty"]:
        erros.append("A senha deve ser diferente de 'password', '12345678' e 'qwerty'.")
    
    if not any(char.islower() for char in senha):
        erros.append("A senha deve conter pelo menos uma letra minúscula.")
    

    return erros

erros = validar_senha(senha)
if not erros:
    print("Senha válida! Parabéns!")   
